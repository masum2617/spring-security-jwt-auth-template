{
  "info": {
    "name": "Spring Boot Security Foundation - API Tests",
    "description": "Run against the local demo profile. Import the companion Local environment, enter your demo passwords locally, and run all folders in order. USER/ADMIN JWTs stay in run-local variables. Negative cases deliberately expect 400, 401, or 403. Database-mode business routes are application-specific and are not covered by this demo collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - USER flow",
      "description": "Run first. Tokens are captured only in collection-run local variables.",
      "item": [
        {
          "name": "01 - Login as USER",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Loads userEmail/userPassword from the selected environment. Never stores the returned JWT in the environment.",
            "body": {
              "mode": "raw",
              "raw": "{{loginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.get(\"userEmail\");",
                  "const password = pm.variables.get(\"userPassword\");",
                  "if (!email || !password) {",
                  "    throw new Error(\"Set userEmail and userPassword in the selected local environment first.\");",
                  "}",
                  "pm.variables.unset(\"userAccessToken\");",
                  "pm.variables.set(\"loginBody\", JSON.stringify({email: email, password: password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Access token response follows the login contract\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a(\"string\");",
                  "    pm.expect(body.accessToken.split(\".\").length).to.eql(3);",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresInSeconds).to.be.within(60, 3600);",
                  "    pm.expect(body).not.to.have.property(\"password\");",
                  "    pm.expect(body).not.to.have.property(\"refreshToken\");",
                  "});",
                  "pm.test(\"Login response is not cached and creates no cookie\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "    pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.eql(false);",
                  "});",
                  "// Local variables survive the collection run, not a shared environment export.",
                  "if (pm.response.code === 200) {",
                  "    const token = pm.response.json().accessToken;",
                  "    if (typeof token === \"string\" && token.split(\".\").length === 3) {",
                  "        pm.variables.set(\"userAccessToken\", token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - USER can read profile",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/demo/profile",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"userAccessToken\")) {",
                  "    throw new Error(\"Run the collection from login first; JWTs are kept only for this run.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Identity and authorities match the demo account\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.userId).to.eql(\"demo-user\");",
                  "    pm.expect(body.authorities).to.include(\"ROLE_USER\");",
                  "    pm.expect(body).not.to.have.property(\"password\");",
                  "    pm.expect(body).not.to.have.property(\"accessToken\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - USER cannot access admin",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/demo/admin",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"userAccessToken\")) {",
                  "    throw new Error(\"Run the collection from login first; JWTs are kept only for this run.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Problem Details response\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(403);",
                  "    pm.expect(body.detail).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Bearer challenge is preserved\", function () {",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
