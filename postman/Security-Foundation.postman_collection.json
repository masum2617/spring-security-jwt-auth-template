                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.get(\"userEmail\");",
                  "const password = pm.variables.get(\"userPassword\");",
                  "if (!email || !password) {",
                  "    throw new Error(\"Set userEmail and userPassword in the selected local environment first.\");",
