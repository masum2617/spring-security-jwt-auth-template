            "url": "{{baseUrl}}/api/auth/login",
            "description": "The login contract rejects unknown properties rather than accepting client roles.",
            "body": {
              "mode": "raw",
              "raw": "{{injectedLoginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
